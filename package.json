  "license": "ISC",
  "type": "commonjs",
  "engines": { "node": ">=20.19.0" },
  "bugs": { "url": "https://github.com/BeFinkler/AplicacaoWebMVC/issues" },
  "homepage": "https://github.com/BeFinkler/AplicacaoWebMVC#readme",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.4"
  },
  "devDependencies": { "supertest": "^7.1.4" }
