# Copie para .env e preencha os valores reais. Nunca versione esse arquivo.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>/<database>?retryWrites=true&w=majority
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=uma_chave_com_ao_menos_32_caracteres
PORT=3000
NODE_ENV=development

# Opcional: cria este usuario apenas se ainda nao existir.
SEED_USER_NAME=Usuario administrador
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque-esta-senha
