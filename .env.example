# Aplicação
PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/Sao_Paulo
TRUST_PROXY=0

# MySQL local ou Aiven
DB_HOST=localhost
DB_PORT=3306
DB_USER=eventhub
DB_PASSWORD=troque-esta-senha
DB_NAME=eventhub

# Use false somente no MySQL local sem TLS. No Aiven, mantenha true.
DB_SSL=false
# No Aiven, converta o arquivo ca.pem para Base64 e informe o valor abaixo.
DB_SSL_CA_BASE64=

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=gere-uma-chave-com-pelo-menos-32-caracteres
SESSION_COOKIE_NAME=eventhub.sid

# Opcionais: usados uma única vez para criar o primeiro organizador.
# Remova estas variáveis do Render depois que o usuário for criado.
SEED_ORGANIZER_NAME=
SEED_ORGANIZER_EMAIL=
SEED_ORGANIZER_PASSWORD=
