<%- include('partials/header') %>

<section class="hero-card">
    <div class="hero-copy">
        <span class="eyebrow">Conexões que viram experiências</span>
        <h1>Encontre, organize e viva bons eventos.</h1>
        <p>O EventHub aproxima participantes de encontros acadêmicos e corporativos, com inscrições simples e gestão segura.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-lg" href="/eventos">Explorar eventos</a>
            <% if (!user) { %><a class="btn btn-outline-light btn-lg" href="/cadastro">Criar minha conta</a><% } %>
        </div>
    </div>
    <div class="hero-mark" aria-hidden="true">EH</div>
</section>

<section class="section-heading">
    <div><span class="eyebrow text-primary">Agenda</span><h2>Próximos eventos</h2></div>
    <a href="/eventos">Ver todos</a>
</section>

<% if (!events.length) { %>
    <div class="empty-state"><h3>A agenda está sendo preparada</h3><p>Novos eventos aparecerão aqui assim que forem publicados.</p></div>
<% } else { %>
    <div class="row g-4">
        <% events.forEach(event => { %>
            <div class="col-md-6 col-xl-4">
                <article class="event-card h-100">
                    <div class="event-date"><strong><%= formatDateTime(event.inicio) %></strong></div>
                    <h3><%= event.titulo %></h3>
                    <p class="event-location"><%= event.local %></p>
                    <p class="event-description"><%= event.descricao %></p>
                    <div class="event-card-footer"><span><%= Number(event.inscritos) %>/<%= event.capacidade %> inscritos</span><a href="/eventos/<%= event.id %>">Detalhes</a></div>
                </article>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>
