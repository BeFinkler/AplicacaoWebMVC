<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="EventHub: eventos acadêmicos e corporativos em um só lugar.">
    <title><%= title ? `${title} | EventHub` : 'EventHub' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark eventhub-nav">
        <div class="container py-2">
            <a class="navbar-brand fw-bold" href="/">Event<span>Hub</span></a>
            <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                <a class="nav-link-custom <%= currentPath === '/eventos' ? 'active' : '' %>" href="/eventos">Eventos</a>
                <a class="nav-link-custom <%= currentPath === '/sobre' ? 'active' : '' %>" href="/sobre">Sobre</a>
                <% if (!user) { %>
                    <a class="btn btn-outline-light btn-sm" href="/login">Entrar</a>
                    <a class="btn btn-light btn-sm" href="/cadastro">Criar conta</a>
                <% } else { %>
                    <% if (user.role === 'organizador') { %>
                        <a class="btn btn-light btn-sm" href="/organizador">Meus eventos</a>
                    <% } else { %>
                        <a class="btn btn-light btn-sm" href="/minhas-inscricoes">Minhas inscrições</a>
                    <% } %>
                    <span class="user-badge"><%= user.name %></span>
                    <form action="/logout" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-outline-light btn-sm" type="submit">Sair</button>
                    </form>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container page-content">
        <% if (flash) { %>
            <div class="alert alert-<%= flash.type %> shadow-sm" role="alert"><%= flash.message %></div>
        <% } %>
